# Supabase Configuration
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to use in client-side code)
# Used for public-facing features with RLS protection
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key (bypasses RLS - keep secret!)
# ⚠️ WARNING: This key bypasses ALL row-level security
# Only use for:
# - Internal admin tools
# - Server-side operations
# - Trusted environments
# NEVER commit this to version control
# NEVER expose in public websites
VITE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Fill in your actual Supabase credentials
# 3. Make sure .env is in .gitignore
